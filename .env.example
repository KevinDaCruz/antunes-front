# Copie ce fichier en .env et renseigne tes propres valeurs.
# .env n'est jamais commité (voir .gitignore).

# Identifiant de mesure Google Analytics 4 (ex: G-XXXXXXXXXX).
# Laisse vide pour désactiver le tracking (par défaut en développement).
VITE_GA_MEASUREMENT_ID=

# URL de base de l'API back-end (antunes-back).
VITE_API_URL=http://localhost:4000/api
